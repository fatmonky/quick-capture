default_platform(:ios)

platform :ios do
  desc "Build, upload the build, metadata and screenshots to App Store Connect (does not submit for review)"
  lane :upload do
    api_key = app_store_connect_api_key(
      key_id: "CRM6VWSFVN",
      issuer_id: "7ec63674-7366-4059-9ebe-c2da06c2201e",
      key_filepath: ENV["ASC_KEY_PATH"],
      duration: 1200,
      in_house: false
    )

    sh("cd .. && xcodegen generate")

    build_number = latest_testflight_build_number(api_key: api_key, initial_build_number: 0) + 1
    build_app(
      project: "QuickCapture.xcodeproj",
      scheme: "QuickCapture",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "QuickCapture.ipa",
      clean: true,
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number} -allowProvisioningUpdates"
    )

    upload_to_app_store(
      api_key: api_key,
      app_rating_config_path: "./fastlane/rating.json",
      overwrite_screenshots: true,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false
    )
  end
end
